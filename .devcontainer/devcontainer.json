{
  "name": "FastAPI Auto-Run",
  "image": "://microsoft.com",
  "onCreateCommand": "pip install fastapi uvicorn requests beautifulsoup4",
  "postStartCommand": "uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Web Preview",
      "onAutoForward": "openBrowser"
    }
  }
}
